DROP TABLE IF EXISTS p26_t;
CREATE TABLE p26_t (id int PRIMARY KEY, s text);
INSERT INTO p26_t VALUES (1, 'a'), (2, 'b');
BEGIN;
SELECT s FROM p26_t WHERE id = 1 FOR UPDATE;
 s 
