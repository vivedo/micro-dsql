CREATE INDEX ASYNC p28_hash ON p28_t USING hash (c1);
psql:28_index_forms.sql:10: ERROR:  0A000: USING not supported for CREATE INDEX
CREATE INDEX ASYNC IF NOT EXISTS ON p28_t (c1);
