DROP TABLE IF EXISTS p28_t;
CREATE TABLE p28_t (id int PRIMARY KEY, c1 int, c2 int, c3 int, c4 int, c5 int, c6 int, c7 int, c8 int, c9 int, s text);
CREATE INDEX CONCURRENTLY p28_conc ON p28_t (c1);
